{
  "name": "ae-bridge",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) bridge connecting AI agents to Adobe After Effects",
  "type": "module",
  "bin": {
    "ae-bridge": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "docs": "tsx scripts/gen-docs.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "sharp": "^0.35.5",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/sharp": "^0.31.1",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12",
    "zod-to-json-schema": "^3.25.2"
  }
}
